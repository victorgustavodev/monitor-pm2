# Primeiro usuário (criado no MongoDB somente se não houver usuários)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
JWT_SECRET=gere-um-segredo-longo-com-pelo-menos-32-caracteres

# Rede
PORT=4170
HOST=0.0.0.0

# PM2 (o backend usa a dependência local por padrão; sobrescreva apenas se necessário)
# PM2_SCRIPT=C:\Users\usuario\AppData\Roaming\npm\node_modules\pm2\bin\pm2
# PM2_HOME=C:\Users\usuario\.pm2

# Use true quando o painel for acessado por HTTPS.
COOKIE_SECURE=false

# MongoDB: banco de usuários, auditoria, logs dos processos e metadados das versões
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=monitor_pm2

# Builds (caminho relativo à raiz do projeto ou absoluto)
VERSIONS_DIR=versions
UPLOAD_MAX_MB=100
EXTRACTED_MAX_MB=1024
